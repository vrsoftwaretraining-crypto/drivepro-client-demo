// Developed by @Ramana Code Softwares
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().active == true;
    }

    function isAdmin() {
      return activeUser() && userDoc().role == 'admin';
    }

    function isInstructor() {
      return activeUser() && userDoc().role == 'instructor';
    }

    function isStudent() {
      return activeUser() && userDoc().role == 'student';
    }

    function validHold() {
      let d = request.resource.data;
      return d.keys().hasOnly(['instructorId', 'vehicleId', 'startAt', 'durationMinutes',
                'status', 'holdExpiresAt', 'bookingRequestId', 'kind'])
        && d.status == 'held'
        && d.durationMinutes in [60, 90, 120]
        && d.startAt > request.time
        // 30 min cap tolerates a phone clock that is a few minutes off.
        && d.holdExpiresAt <= request.time + duration.value(30, 'm');
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
      // First-run bootstrap: the very first admin can create their own profile
      // (only while system/bootstrap does not exist yet).
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/system/bootstrap);
      // A user may only finish their own first-login setup.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['securityQuestionsSet', 'mustChangePassword', 'updatedAt'])
        && request.resource.data.mustChangePassword == false
        && request.resource.data.securityQuestionsSet == true;
    }

    match /system/{docId} {
      allow get: if true;
      allow create: if signedIn() && docId == 'bootstrap'
        && !exists(/databases/$(database)/documents/system/bootstrap);
    }

    // username/email -> login email. Public get only (no listing).
    match /login_index/{key} {
      allow get: if true;
      allow create, update, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && key == request.auth.token.email.lower();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Salted/iterated hashes of security answers (see docs for the trade-off).
    match /recovery/{uid} {
      allow get: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Public-safe mirrors written by admin (no phone / licence data).
    match /public_instructors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /public_vehicles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /public_info/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin()
        || (isInstructor() && resource.data.assignedInstructorId == request.auth.uid)
        || (isStudent() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Public website receives a sanitized catalogue from getPublicCatalog.
    // Keep source records private because they contain instructor contact/licence data.
    match /instructors/{instructorId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin()
        || (isInstructor() && resource.data.instructorId == request.auth.uid)
        || (isStudent() && resource.data.studentUserId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUserId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (isInstructor() && resource.data.instructorUserId == request.auth.uid)
        || (isStudent() && resource.data.studentUserId == request.auth.uid);
      allow create: if isAdmin()
        || (isInstructor() && request.resource.data.instructorUserId == request.auth.uid);
      allow update: if isAdmin()
        || (isInstructor() && resource.data.instructorUserId == request.auth.uid
            && request.resource.data.instructorUserId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /reminders/{reminderId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.userId == request.auth.uid)
        || (isInstructor() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /call_enquiries/{enquiryId} {
      allow read, update, create: if isAdmin(); // admin phone syncs auto-reply log rows
      allow delete: if false;
      // Public "call me back" form (web_enquiry) – validated, size-limited.
      allow create: if request.resource.data.source == 'web_enquiry'
        && request.resource.data.keys().hasOnly(['source', 'callerName', 'phoneNumber',
            'callStatus', 'smsStatus', 'instructorId', 'instructorName', 'slotLabel',
            'message', 'followUpStatus', 'receivedAt'])
        && request.resource.data.callerName is string && request.resource.data.callerName.size() <= 100
        && request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 20
        && request.resource.data.message.size() <= 500
        && request.resource.data.receivedAt == request.time;
    }

    match /booking_requests/{requestId} {
      allow read: if isAdmin()
        || (activeUser() && resource.data.studentUserId == request.auth.uid);
      allow create, update, delete: if isAdmin();
      // Public booking request (written in the same transaction as the slot hold).
      allow create: if request.resource.data.status == 'pending_admin_contact'
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'pickupAddress', 'course', 'instructorId', 'instructorName', 'vehicleId', 'vehicleRegistration', 'anyInstructor', 'slotId', 'vehicleSlotId', 'startAt', 'durationMinutes', 'status', 'paymentStatus', 'holdExpiresAt', 'createdAt'])
        && request.resource.data.pickupAddress is string
        && request.resource.data.pickupAddress.size() >= 5
        && request.resource.data.pickupAddress.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.startAt > request.time;
    }

    match /booking_slots/{slotId} {
      allow read: if true; // public slot board (no personal data stored here)
      allow create, update, delete: if isAdmin();
      // Public 15-minute hold. An existing slot can be re-held only if its hold expired.
      allow create: if validHold();
      allow update: if resource.data.status == 'held'
        && resource.data.holdExpiresAt < request.time && validHold();
    }

    // ------------------------------------------------------------------
    // Schedule module: slots are created by the admin and are public to read
    // (they hold no personal data). A visitor or student can only flip an open
    // slot to "booked"; the booking details live in slot_bookings (private).
    // ------------------------------------------------------------------
    match /schedule_slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      allow update: if resource.data.status == 'available'
        && request.resource.data.status == 'booked'
        && resource.data.startAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookingId', 'updatedAt'])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0;
    }

    match /slot_bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentUserId == request.auth.uid);
      allow create, update, delete: if isAdmin();
      // Booking by a student or a website visitor. It must be written in the same transaction
      // that turns the slot to "booked" with this booking's id (checked with getAfter).
      allow create: if request.resource.data.keys().hasOnly(['slotId', 'studentUserId', 'studentId', 'name', 'phone',
            'email', 'notes', 'status', 'startAt', 'durationMinutes', 'location', 'vehicleName', 'instructorId',
            'instructorName', 'courseName', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
        && request.resource.data.notes.size() <= 500
        && (request.resource.data.studentUserId == ''
            || (signedIn() && request.resource.data.studentUserId == request.auth.uid))
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/schedule_slots/$(request.resource.data.slotId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/schedule_slots/$(request.resource.data.slotId)).data.status == 'booked';
    }

    // Hashed security answers: only Cloud Functions (Admin SDK) may touch these.
    match /security_questions/{uid} {
      allow read, write: if false;
    }

    match /school_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
